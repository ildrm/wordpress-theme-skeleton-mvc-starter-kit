{
  "name": "wpmvc-theme",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint resources/js vite.config.js playwright.config.js tests/Browser",
    "lint:css": "stylelint 'resources/css/**/*.css' style.css",
    "test": "npm run lint",
    "test:wp": "node tests/Integration/wordpress-smoke.mjs",
    "test:e2e": "playwright test",
    "i18n:pot": "wp i18n make-pot . languages/wpmvc-theme.pot --slug=wpmvc-theme --domain=wpmvc-theme --exclude=node_modules,vendor,public/build,tests --skip-theme-json",
    "i18n:pot:full": "wp i18n make-pot . languages/wpmvc-theme.pot --slug=wpmvc-theme --domain=wpmvc-theme --exclude=node_modules,vendor,public/build,tests"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "eslint": "^10.11.0",
    "globals": "^16.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
