{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "background", "name": "Background", "color": "#f8fafc" },
        { "slug": "surface", "name": "Surface", "color": "#ffffff" },
        { "slug": "foreground", "name": "Foreground", "color": "#17212e" },
        { "slug": "muted", "name": "Muted", "color": "#475569" },
        { "slug": "accent", "name": "Accent", "color": "#155e75" }
      ]
    },
    "layout": {
      "contentSize": "48rem",
      "wideSize": "76rem"
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw"],
      "spacingSizes": [
        { "slug": "20", "name": "Small", "size": "0.75rem" },
        { "slug": "40", "name": "Medium", "size": "1.5rem" },
        { "slug": "60", "name": "Large", "size": "3rem" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System Sans",
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "slug": "serif",
          "name": "System Serif",
          "fontFamily": "Georgia, 'Times New Roman', serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Medium", "size": "1rem" },
        { "slug": "large", "name": "Large", "size": "1.25rem" },
        { "slug": "x-large", "name": "Extra Large", "size": "clamp(2rem, 4vw, 3.25rem)" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|foreground"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system",
      "lineHeight": "1.65"
    },
    "elements": {
      "link": {
        "color": { "text": "var:preset|color|accent" }
      },
      "heading": {
        "typography": { "lineHeight": "1.2" }
      }
    }
  }
}
