<?xml version="1.0"?>
<ruleset name="WPMVC Theme">
    <description>WordPress coding standards for the theme skeleton.</description>
    <file>.</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/public/build/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="p"/>
    <config name="text_domain" value="wpmvc-theme"/>
    <rule ref="WordPress-Core"/>
    <rule ref="WordPress-Docs"/>
    <rule ref="WordPress-Extra"/>
    <!-- PSR-4, typed APIs, and PHP short arrays are deliberate for this namespaced theme. -->
    <rule ref="WordPress.Files.FileName"><severity>0</severity></rule>
    <rule ref="WordPress.NamingConventions.ValidFunctionName"><severity>0</severity></rule>
    <rule ref="WordPress.NamingConventions.ValidVariableName"><severity>0</severity></rule>
    <rule ref="Universal.Arrays.DisallowShortArraySyntax"><severity>0</severity></rule>
    <rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames"><severity>0</severity></rule>
    <rule ref="WordPress.PHP.YodaConditions"><severity>0</severity></rule>
    <!-- PHP types and focused comments replace the legacy full docblock requirement. -->
    <rule ref="Squiz.Commenting.FunctionComment"><severity>0</severity></rule>
    <rule ref="Squiz.Commenting.FunctionCommentThrowTag"><severity>0</severity></rule>
    <rule ref="Squiz.Commenting.ClassComment"><severity>0</severity></rule>
    <rule ref="Squiz.Commenting.FileComment"><severity>0</severity></rule>
    <rule ref="Generic.Commenting.DocComment"><severity>0</severity></rule>
    <!-- Throwing an exception is not browser output. Output escaping remains enabled. -->
    <rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped"><severity>0</severity></rule>
</ruleset>
